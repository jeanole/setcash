# Copy this file to .env.test and fill in real values
# This file is used by docker-compose.test.yml (env_file: .env.test)
# DATABASE_URL uses the Docker-internal service name "postgres-test"
DATABASE_URL=postgresql://vbudget:vbudget_test@postgres-test:5432/vbudget
NEXTAUTH_SECRET=change-this-to-a-long-random-secret
NEXTAUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
UPLOAD_DIR=./public/uploads
SQLITE_PATH=../data/vbudget.db
