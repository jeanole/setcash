# Copy this file to .env.test and fill in real values
# This file is used by docker-compose.test.yml (env_file: .env.test)
# DATABASE_URL uses the Docker-internal service name "postgres-test"
DATABASE_URL=postgresql://setcash:setcash_test@postgres-test:5432/setcash
NEXTAUTH_SECRET=change-this-to-a-long-random-secret
AUTH_SECRET=change-this-to-a-long-random-secret
NEXTAUTH_URL=http://localhost:3001
AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
UPLOAD_DIR=./public/uploads
SESSION_SECRET=change-this-session-secret
OCR_ENCRYPTION_SECRET=change-this-16char-min
RESEND_API_KEY=re_your_resend_api_key
NEXT_PUBLIC_APP_URL=http://localhost:3001
EMAIL_FROM=onboarding@resend.dev
EXTERNAL_REGISTRATION=false
GITHUB_REPO=jeanole/setcash
GITHUB_TOKEN=github_pa
