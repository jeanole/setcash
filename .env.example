# Development mode - bypasses authentication with dev@example.com
DEV_MODE=true

# Session secret (use a long random string in production!)
SESSION_SECRET=change-this-to-a-random-string

# Users - format: email:bcrypt_hash:role,email:bcrypt_hash:role
# Generate hashes at /setup when server is running
# Role: admin or user
# Example: USERS=admin@example.com:$2b$10$abc...:admin,user@example.com:$2b$10$xyz...:user
USERS=

# Google Sheets ID (optional - for production use)
TARGET_SHEET_ID=

# Google Drive folder ID (optional - for production use)
DRIVE_FOLDER_ID=

# Service account (optional - for production use)
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
