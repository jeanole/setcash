# Google OAuth credentials (from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=976956404918-.aoogleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-
GOOGLE_OAUTH_CALLBACK=http://localhost:3000/google/callback

# Google Sheets ID (from the sheet URL)
TARGET_SHEET_ID=your-google-sheet-id

# Google Drive folder ID (from the folder URL)
DRIVE_FOLDER_ID=your-drive-folder-id

# Admin credentials for the initial user created on first run
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Session secret (random string for security)
SESSION_SECRET=change-this-to-a-random-string

# Service account credentials (JSON string or file path)
# Option 1: JSON string
# GOOGLE_SERVICE_ACCOUNT_CREDENTIALS={"type":"service_account",...}
# Option 2: File path
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
