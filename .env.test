# Docker-internal DATABASE_URL (uses service name "postgres-test", not localhost)
DATABASE_URL=postgresql://vbudget:vbudget_test@postgres-test:5432/vbudget
NEXTAUTH_SECRET=qa-test-secret-not-for-production
NEXTAUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=not-configured
GOOGLE_CLIENT_SECRET=not-configured
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
UPLOAD_DIR=./public/uploads
SQLITE_PATH=../data/vbudget.db
