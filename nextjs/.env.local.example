# SetCash — Local Development Environment Variables
# Copy this file to .env.local and fill in the values.

DATABASE_URL=postgresql://setcash:setcash_dev@localhost:5432/setcash
NEXTAUTH_SECRET=change-this-to-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
RESEND_API_KEY=re_xxxxxxxxx
NEXT_PUBLIC_APP_URL=http://localhost:3000
OCR_ENCRYPTION_SECRET=change-this-32-byte-encryption-key!!
TELEGRAM_ENCRYPTION_KEY=change-this-32-byte-encryption-key!!
SESSION_SECRET=change-this-to-a-long-random-secret

# Demo login (optional — used by /api/auth/demo-login for a public demo account)
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=demo123

# Transactional email
EMAIL_FROM=SetCash <noreply@example.com>

# Rate limiting via Upstash Redis (optional — falls back to in-memory when unset)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Cloudflare Turnstile (optional — bot protection on demo login)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# GitHub issue creation for bug reports (optional)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=your-org/your-repo

# Allow public signup without an invite (optional, defaults to disabled)
EXTERNAL_REGISTRATION=false

# Analytics retention window in days for /api/admin/analytics/prune
# (optional, defaults to 90, clamped to a minimum of 30)
ANALYTICS_RETENTION_DAYS=90

# S3-Compatible Storage (optional — falls back to local disk when unset)
# Works with MinIO, Hetzner Object Storage, Cloudflare R2, AWS S3
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
# Optional: public URL to rewrite in presigned URLs (needed when STORAGE_ENDPOINT
# is a private/internal hostname not reachable by browsers, e.g. Docker dev setups)
STORAGE_PUBLIC_URL=
