# SetCash — Local Development Environment Variables
# Copy this file to .env.local and fill in the values.

DATABASE_URL=postgresql://setcash:setcash_dev@localhost:5432/setcash
NEXTAUTH_SECRET=change-this-to-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
RESEND_API_KEY=re_xxxxxxxxx
NEXT_PUBLIC_APP_URL=http://localhost:3000
OCR_ENCRYPTION_SECRET=change-this-32-byte-encryption-key!!
TELEGRAM_ENCRYPTION_KEY=change-this-32-byte-encryption-key!!

# S3-Compatible Storage (optional — falls back to local disk when unset)
# Works with MinIO, Hetzner Object Storage, Cloudflare R2, AWS S3
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
# Optional: public URL to rewrite in presigned URLs (needed when STORAGE_ENDPOINT
# is a private/internal hostname not reachable by browsers, e.g. Docker dev setups)
STORAGE_PUBLIC_URL=
